              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">12</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="GLTFHELPNote0000000001" Bounds="72,124,700,41" ShowValueBox="true" isIOBox="true" Value="The built in FileModel node imports through Assimp and drops every UV set after the 8th. &#xD;&#xA;Blender writes all UV maps as TEXCOORD_n attributes into glTF files.">
